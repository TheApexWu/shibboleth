# copy to .env.local (gitignored). Same cluster as the Python side's .env.
# Leave ATLAS_URI unset to run against the built-in demo fixture (UI shows a banner).
ATLAS_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Prefill for the live-scan form, so nobody types during the demo (a pre-cached model on the Mini).
NEXT_PUBLIC_DEMO_MODEL=
NEXT_PUBLIC_DEMO_DECLARED=uncensored
NEXT_PUBLIC_DEMO_PATH=
